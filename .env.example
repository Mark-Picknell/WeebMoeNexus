PORT=3000

# AniDB requires a registered API client name/version.
ANIDB_CLIENT=weebmoenexus
ANIDB_CLIENT_VERSION=1

# We default to the documented AniDB HTTP API endpoint.
ANIDB_HTTP_API_URL=http://api.anidb.net:9001/httpapi

# AniDB is strict. We clamp this to >= 2000 ms in code.
ANIDB_MIN_INTERVAL_MS=2500

# Cache successful anime responses for 72 hours by default.
ANIDB_CACHE_TTL_MS=259200000
