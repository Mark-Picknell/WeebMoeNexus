PORT=3000

# AniDB requires a registered API client name/version.
# Leave blank until you have registered WeebMoeNexus (or your own client) with AniDB.
ANIDB_CLIENT=
ANIDB_CLIENT_VERSION=1

# We default to the documented AniDB HTTP API endpoint.
ANIDB_HTTP_API_URL=http://api.anidb.net:9001/httpapi

# AniDB is strict. We clamp this to >= 2000 ms in code.
ANIDB_MIN_INTERVAL_MS=2500

# Cache successful anime responses for 72 hours by default.
ANIDB_CACHE_TTL_MS=259200000

# Successful normalized anime records survive restarts in this local directory.
# Empty disables disk persistence. Use a persistent writable volume when hosted.
ANIDB_ANIME_CACHE_DIR=.cache/anidb/anime

# Default local-only mode. Hosted modes require the settings in docs/DEPLOYMENT.md.
WMN_HTTP_MODE=local
WMN_BIND_HOST=127.0.0.1
# WMN_ALLOWED_HOSTS=<approved hostname without scheme or port>
# WMN_ALLOWED_ORIGINS=<comma-separated exact browser origins, or omit>
# WMN_PUBLIC_READ_ONLY=true  # required for public mode
# WMN_BEARER_TOKEN=<secret injected by the host>  # bearer mode only; never commit
