{
  "name": "weeb-moe-nexus",
  "version": "0.1.0",
  "description": "A provider-independent anime knowledge MCP server, beginning with AniDB.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
